{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Lucasuiii/cumcm-codex-workflow/main/.agents/skills/cumcm-workflow/schemas/run-manifest.schema.json",
  "allOf": [{"$ref": "common.schema.json#/$defs/envelope"}],
  "type": "object",
  "required": ["run_id", "purpose", "subproblem_id", "capability_ids", "argv", "working_directory", "started_at", "finished_at", "exit_code", "status", "inputs", "outputs", "environment", "stdout_path", "stderr_path", "assertions"],
  "properties": {
    "artifact_type": {"const": "run_manifest"},
    "run_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "subproblem_id": {"type": "string", "minLength": 1},
    "capability_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "working_directory": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "exit_code": {"type": "integer"},
    "status": {"enum": ["completed", "failed", "interrupted"]},
    "inputs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/file_record"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/file_record"}},
    "environment": {"type": "object"},
    "stdout_path": {"type": "string", "minLength": 1},
    "stderr_path": {"type": "string", "minLength": 1},
    "assertions": {"type": "array"},
    "parent_run_id": {"type": ["string", "null"]}
  }
}
