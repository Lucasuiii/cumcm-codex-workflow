{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Lucasuiii/cumcm-codex-workflow/main/.agents/skills/cumcm-workflow/schemas/paper-traceability.schema.json",
  "allOf": [{"$ref": "common.schema.json#/$defs/envelope"}],
  "type": "object",
  "required": ["visible_id_policy", "entries"],
  "properties": {
    "artifact_type": {"const": "paper_traceability"},
    "visible_id_policy": {"const": "prohibited"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["anchor", "paper_location", "claim_ids", "result_ids", "render_policy"],
        "properties": {
          "anchor": {"type": "string", "minLength": 1},
          "paper_location": {"type": "string", "minLength": 1},
          "claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "result_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "render_policy": {"const": "sidecar_only"}
        },
        "additionalProperties": false
      }
    }
  }
}
