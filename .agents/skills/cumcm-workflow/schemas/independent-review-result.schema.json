{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Lucasuiii/cumcm-codex-workflow/main/.agents/skills/cumcm-workflow/schemas/independent-review-result.schema.json",
  "allOf": [{"$ref": "common.schema.json#/$defs/envelope"}],
  "type": "object",
  "required": ["package_manifest_path", "reviewer_context", "verdict", "findings", "raw_review_path", "reviewed_files"],
  "properties": {
    "artifact_type": {"const": "independent_review_result"},
    "package_manifest_path": {"type": "string", "minLength": 1},
    "reviewer_context": {
      "type": "object",
      "required": ["reviewer_kind", "reviewer", "model", "task_ref", "different_conversation", "selected_by_user", "independence_grade"],
      "properties": {
        "reviewer_kind": {"enum": ["human", "different_model", "same_model_new_context", "same_context_model"]},
        "reviewer": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]},
        "task_ref": {"type": "string", "minLength": 1},
        "different_conversation": {"type": "boolean"},
        "selected_by_user": {"type": "boolean"},
        "independence_grade": {"enum": ["independent", "context_separated_model_correlated", "correlated_self_review"]}
      },
      "additionalProperties": false
    },
    "verdict": {"enum": ["accepted", "revision_requested", "inconclusive"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "category", "location", "evidence", "recommendation"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["fatal", "major", "minor"]},
          "category": {"enum": ["task_interpretation", "bound_direction", "double_count", "extrapolation", "missing_variable", "cross_question", "implementation", "numerical", "other"]},
          "location": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "raw_review_path": {"type": "string", "minLength": 1},
    "reviewed_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
