{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Lucasuiii/cumcm-codex-workflow/main/.agents/skills/cumcm-workflow/schemas/model-contract.schema.json",
  "allOf": [{"$ref": "common.schema.json#/$defs/envelope"}],
  "type": "object",
  "required": ["components"],
  "properties": {
    "artifact_type": {"const": "model_contract"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["model_id", "capability_ids", "variables", "inputs", "outputs", "method", "scope", "verification_plan", "alternatives_considered"],
        "properties": {
          "model_id": {"type": "string", "minLength": 1},
          "capability_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "variables": {"type": "array", "minItems": 1},
          "inputs": {"type": "array", "minItems": 1},
          "outputs": {"type": "array", "minItems": 1},
          "method": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "verification_plan": {"type": "array", "minItems": 1},
          "alternatives_considered": {"type": "array"},
          "strong_claims": {"type": "array"}
        },
        "additionalProperties": true
      }
    }
  }
}
