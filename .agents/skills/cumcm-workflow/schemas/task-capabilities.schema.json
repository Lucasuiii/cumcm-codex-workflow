{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Lucasuiii/cumcm-workflow/main/.agents/skills/cumcm-workflow/schemas/task-capabilities.schema.json",
  "allOf": [{"$ref": "common.schema.json#/$defs/envelope"}],
  "type": "object",
  "required": ["capabilities"],
  "properties": {
    "artifact_type": {"const": "task_capabilities"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability_id", "subproblem_id", "objective", "required_output", "fact_ids", "acceptance_checks", "model_ids", "code_entry_points", "result_ids", "lifecycle_state", "blocking_issues"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "subproblem_id": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "required_output": {"type": "string", "minLength": 1},
          "fact_ids": {"type": "array", "items": {"type": "string"}},
          "acceptance_checks": {"type": "array", "minItems": 1},
          "model_ids": {"type": "array", "items": {"type": "string"}},
          "code_entry_points": {"type": "array", "items": {"type": "string"}},
          "result_ids": {"type": "array", "items": {"type": "string"}},
          "lifecycle_state": {"enum": ["planned", "implemented", "executed", "validated", "blocked"]},
          "blocking_issues": {"type": "array"}
        },
        "additionalProperties": true
      }
    }
  }
}
